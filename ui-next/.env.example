# Copy to ui-next/.env and adjust. Real environment variables override these.
# Read by ecosystem.config.js (pm2); NEXT_PUBLIC_BASE_PATH is also read by `next build`.
# NOTE: `npm run dev`/`start` use the hardcoded -p in package.json and IGNORE PORT/HOSTNAME below.
# ngrok/exposure is handled by the shared gateway at ~/IdeaProjects/gateway, not here.

# Basic Auth for the UI (empty = no auth, loopback only). Required when exposed via the gateway.
UI_BASIC_AUTH=userName:Password

# App port. The gateway routes /ai → this PORT (match AI_PORT in the gateway .env).
PORT=5000
HOSTNAME=127.0.0.1

# Path prefix this app is served under behind the gateway. BAKED INTO THE BUILD.
# Must equal the gateway's route prefix for this app. Empty = serve at root (standalone, no proxy).
NEXT_PUBLIC_BASE_PATH=/ai

# Which Claude account the UI spawns `claude` with (máy có nhiều account đã login sẵn).
#   (trống) hoặc default → account mặc định (~/.claude.json)
#   account2 / account3  → ~/.claude-account2 / ~/.claude-account3
#   /abs/path            → dùng nguyên đường dẫn đó
# ⚠️ ĐỪNG đặt `/home/<user>/.claude`: account mặc định = ĐỂ TRỐNG biến này. Trỏ vào ~/.claude làm CLI
# đọc ~/.claude/.claude.json (file stub, chỉ 1 MCP server) thay vì ~/.claude.json (đủ 5) → agent mất
# mysql_207/gsheets/figma. Đổi giá trị xong PHẢI `pm2 restart ecosystem.config.js --update-env`
# (restart theo TÊN process sẽ giữ env cũ). Đổi account cũng đổi luôn nguồn transcript cho /usage.
CLAUDE_ACCOUNT=

# Parent dir holding the sibling project repos (rezil-esms*, story, ai-film-studio). config/*.json
# store repo paths as bare folder names relative to this. Default = parent of this repo (repos
# checked out side-by-side). Set this to relocate on another machine without editing config/*.json.
# REZIL_ROOT=/home/youruser/IdeaProjects

# --- Jira REST (Report console) ----------------------------------------------
# The /report page fetches Jira DIRECTLY via REST (no MCP) to compute deterministic counts.
# Auth = Basic base64(email:token). JIRA_API_EMAIL = the Atlassian account email that owns the token;
# JIRA_API_TOKEN = an API token from https://id.atlassian.com/manage-profile/security/api-tokens.
# Site host comes from config/jira.json. Leave empty and /report will return a clear error.
JIRA_API_EMAIL=
JIRA_API_TOKEN=

# --- Telegram bot (optional) -------------------------------------------------
# Turns Telegram into a 2nd chat channel driving the agent (long-polling). It runs as its OWN pm2
# app (`ai-agent-telegram`, telegram-bot.mjs) so it survives restarts/crashes of the Next app and can
# be used to bring it back. Leave TELEGRAM_BOT_TOKEN empty to keep it disabled.
# 1) Create a bot with @BotFather → paste the token below.
# 2) Start with an empty allowlist, message the bot once → it replies with your chat id.
# 3) Put that id in TELEGRAM_ALLOWED_CHAT_IDS (comma-separated for several) and restart pm2.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Which project the agent works on: rezil | story | film | free  (default rezil)
TELEGRAM_PROJECT=rezil
# "1" = allow Edit/Write/Bash (agent can change code); default off = read-only Q&A.
TELEGRAM_CAN_EDIT=0
# Hard cap per message run, ms (default 600000 = 10 min).
TELEGRAM_TIMEOUT_MS=600000
# Apps the /status /restart /logs commands may touch (comma-separated).
TELEGRAM_PM2_APPS=ai-agent-ui-next,ai-agent-telegram
# "1" = run the bot inside the Next app like before (only for `npm run dev`). If you set this, first
# `pm2 stop ai-agent-telegram` — two pollers on one token means Telegram 409 Conflict.
TELEGRAM_IN_PROCESS=0

# Completion ping: after a /api/chat (router /chat) run finishes, send a summary to these chat ids
# (comma-separated; same id you'd get from /whoami above). Reuses TELEGRAM_BOT_TOKEN above — leave
# this empty to keep pings disabled even if the bot itself is configured.
TELEGRAM_NOTIFY_CHAT_IDS=

# Mức suy nghĩ của agent màn /evidence: medium (mặc định, màn mới/còn dò selector) hoặc low (batch
# lặp trên màn đã có SELECTORS_<SCREEN>.md — nhanh hơn, đổi lại dễ ẩu ở khâu tự kiểm ảnh).
# Đổi xong phải: ./scripts/pm2-restart.sh ai-agent-ui-next --fresh
EVIDENCE_EFFORT=medium

# /evidence — cắt phiên khi context đã tích quá ngưỡng (token). Phiên càng dài thì MỖI lượt càng
# đắt vì context được nạp lại toàn bộ; quá ngưỡng, console mở phiên mới và chèn lại dòng <<<STATE>>>
# của lượt trước. 0 = không bao giờ cắt (giữ hành vi cũ). Mặc định 120000.
EVIDENCE_MAX_CTX=120000

# /evidence chạy với --setting-sources '' để bỏ ~13k token nền mỗi lượt, nên mất luôn `model` trong
# ~/.claude/settings.json → truyền lại ở đây. Để trống dòng này là dùng opus[1m].
EVIDENCE_MODEL=opus[1m]


# --- API cho bên thứ ba (/api/v1/generate) -----------------------------------
# Endpoint để hệ thống ngoài gọi Claude sinh nội dung (viết bài, tóm tắt, dịch…). Chạy hộp kín:
# không tool, không MCP, không settings/CLAUDE.md, cwd là thư mục tạm rỗng — xem lib/publicApi.js.
# Bỏ TRỐNG PUBLIC_API_KEYS = endpoint tắt (trả 503). Không gác bằng UI_BASIC_AUTH: mỗi khách 1 key
# để thu hồi riêng. Định dạng: "key:nhãn" cách nhau bằng dấu phẩy (nhãn dùng cho log + hạn mức).
# Sinh key: openssl rand -hex 24
PUBLIC_API_KEYS=
# Hạn mức cho MỖI nhãn khách (van an toàn quota Claude, đếm trong RAM nên reset khi app restart).
PUBLIC_API_RATE_PER_MIN=10
PUBLIC_API_RATE_PER_DAY=200
PUBLIC_API_MAX_CONCURRENT=2
# Trần độ dài prompt (ký tự) và thời gian 1 request (ms).
PUBLIC_API_MAX_PROMPT=8000
PUBLIC_API_TIMEOUT_MS=300000
# Model mặc định khi khách không truyền: haiku | sonnet | opus (mặc định sonnet).
PUBLIC_API_MODEL=sonnet
# Giới hạn CORS về đúng domain của khách; để trống = "*" (vẫn phải có API key).
PUBLIC_API_CORS_ORIGIN=
